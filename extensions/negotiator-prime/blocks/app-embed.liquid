{
  "name": "Negotiator Prime",
  "target": "body",
  "settings": [
    { "type": "color", "id": "main_color", "label": "Cor Primária (Fallback)", "default": "#1B2A4A" },
    { "type": "color", "id": "accent_color", "label": "Cor de Destaque (Fallback)", "default": "#C9A84C" }
  ]
}
