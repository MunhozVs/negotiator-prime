# Shopify CLI usually injects these values during `shopify app dev`.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=

# Use credentials from your own Supabase project.
# This service-role key must only be used by server-side code.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Required server-side n8n webhook credentials. Never expose them in storefront code.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Optional: allow authentication from a custom shop domain.
SHOP_CUSTOM_DOMAIN=
